# ==============================================================================
# AI-Powered Technical Blog Generation Studio - Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="AI-Powered Technical Blog Generation Studio"
ENV="development"
DEBUG=true
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Google Gemini API (Required for text, structured planning, image generation)
GOOGLE_API_KEY=""
GEMINI_TEXT_MODEL="gemini-2.5-flash"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
GEMINI_EMBEDDING_MODEL="models/gemini-embedding-2"

# Tavily Web Research API (Optional - required for web evidence retrieval)
TAVILY_API_KEY=""

# PostgreSQL Database (Optional - defaults to SQLite aiosqlite for zero-setup local dev)
# For local PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/blog_studio
DATABASE_URL="sqlite+aiosqlite:///./blog_studio.db"

# LangGraph PostgreSQL Checkpointer (Optional - defaults to in-memory checkpointer if unset)
# POSTGRES_CHECKPOINT_URL="postgresql://postgres:postgres@localhost:5432/blog_studio"

# Pinecone Vector Database (Optional - in-memory vector similarity fallback active if unset)
PINECONE_API_KEY=""
PINECONE_INDEX_NAME="blog-rag"
PINECONE_NAMESPACE_PREFIX="blog_docs"

# Cloudinary Media Storage (Optional - local storage fallback active if unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="blog_studio"

# Storage Settings
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_MB=25
